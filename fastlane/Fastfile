require "fileutils"
require "shellwords"
require_relative "google_play_listing"

opt_out_usage

default_platform(:android)

def repo_root
  File.expand_path("..", __dir__)
end

def require_env!(name)
  UI.user_error!("#{name} is required") if ENV[name].to_s.strip.empty?
end

def copy_ordered_assets(source_glob, destination_dir, prefix: nil)
  FileUtils.mkdir_p(destination_dir)
  paths = Dir[source_glob].sort
  UI.user_error!("No assets found for #{source_glob}") if paths.empty?

  paths.each_with_index do |path, index|
    basename = File.basename(path)
    output_name = prefix ? "#{prefix}-#{format('%02d', index + 1)}-#{basename}" : basename
    FileUtils.cp(path, File.join(destination_dir, output_name))
  end

  paths.length
end

def png_dimensions(path)
  header = File.binread(path, 24)
  expected_signature = "\x89PNG\r\n\x1a\n".b
  UI.user_error!("Invalid PNG asset: #{path}") unless header.start_with?(expected_signature)

  header.byteslice(16, 8).unpack("N2")
end

def validate_listing_text(path, maximum_characters)
  content = File.read(path, encoding: "UTF-8").strip
  UI.user_error!("Listing text is empty: #{path}") if content.empty?
  UI.user_error!("Listing text exceeds #{maximum_characters} characters: #{path}") if content.length > maximum_characters
end

def validate_png_dimensions(path, expected_dimensions)
  UI.user_error!("Missing listing asset: #{path}") unless File.exist?(path)
  actual_dimensions = png_dimensions(path)
  return if actual_dimensions == expected_dimensions

  UI.user_error!(
    "Unexpected dimensions for #{path}: #{actual_dimensions.join('x')} " \
    "(expected #{expected_dimensions.join('x')})"
  )
end

def validate_store_listing_assets
  source_root = File.join(repo_root, "assets", "store-listing")
  google_root = File.join(source_root, "google-play")
  listing_root = File.join(google_root, "listing", "en-US")

  validate_listing_text(File.join(listing_root, "title.txt"), 30)
  validate_listing_text(File.join(listing_root, "short_description.txt"), 80)
  validate_listing_text(File.join(listing_root, "full_description.txt"), 4_000)
  validate_png_dimensions(File.join(google_root, "icon-512x512.png"), [512, 512])
  validate_png_dimensions(File.join(google_root, "feature-graphic-1024x500.png"), [1024, 500])

  phone_screenshots = Dir[File.join(google_root, "screenshots", "*.png")].sort
  UI.user_error!("No Google Play phone screenshots found") if phone_screenshots.empty?
  phone_screenshots.each { |path| validate_png_dimensions(path, [1080, 1920]) }

  app_store_screenshots = Dir[File.join(source_root, "app-store", "iphone-6-9", "*.png")].sort
  UI.user_error!("No App Store iPhone screenshots found") if app_store_screenshots.empty?
  app_store_screenshots.each { |path| validate_png_dimensions(path, [1320, 2868]) }
end

def prepare_android_listing_assets
  validate_store_listing_assets
  source_root = File.join(repo_root, "assets", "store-listing", "google-play")
  listing_root = File.join(source_root, "listing", "en-US")
  icon = File.join(source_root, "icon-512x512.png")
  feature_graphic = File.join(source_root, "feature-graphic-1024x500.png")
  UI.user_error!("Missing Google Play icon at #{icon}") unless File.exist?(icon)
  UI.user_error!("Missing Google Play feature graphic at #{feature_graphic}") unless File.exist?(feature_graphic)

  metadata_root = File.join(repo_root, "fastlane", "build", "metadata", "android")
  locale_dir = File.join(metadata_root, "en-US")
  images_dir = File.join(locale_dir, "images")
  phone_screenshots_dir = File.join(images_dir, "phoneScreenshots")
  seven_inch_screenshots_dir = File.join(images_dir, "sevenInchScreenshots")
  ten_inch_screenshots_dir = File.join(images_dir, "tenInchScreenshots")

  FileUtils.rm_rf(metadata_root)
  FileUtils.mkdir_p(locale_dir)
  %w[title.txt short_description.txt full_description.txt].each do |filename|
    source = File.join(listing_root, filename)
    UI.user_error!("Missing Google Play listing text at #{source}") unless File.exist?(source)
    FileUtils.cp(source, File.join(locale_dir, filename))
  end
  FileUtils.mkdir_p(images_dir)
  FileUtils.cp(icon, File.join(images_dir, "icon.png"))
  FileUtils.cp(feature_graphic, File.join(images_dir, "featureGraphic.png"))
  phone_screenshot_count = copy_ordered_assets(
    File.join(source_root, "screenshots", "*.png"),
    phone_screenshots_dir
  )
  seven_inch_screenshot_count = copy_ordered_assets(
    File.join(source_root, "seven-inch-tablet-screenshots", "*.png"),
    seven_inch_screenshots_dir
  )
  ten_inch_screenshot_count = copy_ordered_assets(
    File.join(source_root, "ten-inch-tablet-screenshots", "*.png"),
    ten_inch_screenshots_dir
  )

  UI.message(
    "Prepared Google Play listing: metadata, icon, feature graphic, " \
    "#{phone_screenshot_count} phone, #{seven_inch_screenshot_count} seven-inch, " \
    "and #{ten_inch_screenshot_count} ten-inch screenshots"
  )
  metadata_root
end

def prepare_ios_listing_screenshots
  source_glob = File.join(repo_root, "assets", "store-listing", "app-store", "iphone-6-9", "*.png")
  screenshots_root = File.join(repo_root, "fastlane", "build", "screenshots")
  locale_dir = File.join(screenshots_root, "en-US")

  FileUtils.rm_rf(screenshots_root)
  screenshot_count = copy_ordered_assets(source_glob, locale_dir, prefix: "iPhone 16 Pro Max")

  UI.message("Prepared App Store listing assets: #{screenshot_count} iPhone screenshots")
  screenshots_root
end

def app_store_connect_key
  app_store_connect_api_key(
    key_id: ENV.fetch("APP_STORE_CONNECT_API_KEY_ID"),
    issuer_id: ENV.fetch("APP_STORE_CONNECT_ISSUER_ID"),
    key_content: ENV.fetch("APP_STORE_CONNECT_API_KEY_BASE64"),
    is_key_content_base64: true,
    duration: 1200,
    in_house: false
  )
end

platform :android do
  desc "Build and upload the Android app bundle to Google Play internal testing"
  lane :internal do
    version_code = ENV.fetch("ANDROID_VERSION_CODE")
    version_name = ENV.fetch("ANDROID_VERSION_NAME", "1.0.#{version_code}")
    package_name = ENV.fetch("ANDROID_PACKAGE_NAME", "com.jjswigut.oopsallprs.android")
    track = ENV.fetch("ANDROID_PLAY_TRACK", "internal")

    require_env!("GOOGLE_PLAY_SERVICE_ACCOUNT_JSON")

    gradle(
      project_dir: ".",
      task: ":androidApp:bundleRelease",
      properties: {
        "android.injected.version.code" => version_code,
        "android.injected.version.name" => version_name,
      }
    )

    upload_to_play_store(
      package_name: package_name,
      json_key_data: ENV.fetch("GOOGLE_PLAY_SERVICE_ACCOUNT_JSON"),
      aab: "androidApp/build/outputs/bundle/release/androidApp-release.aab",
      track: track,
      release_status: ENV.fetch("ANDROID_RELEASE_STATUS", "completed"),
      skip_upload_apk: true,
      skip_upload_metadata: true,
      skip_upload_changelogs: true,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )
  end

  desc "Prepare Google Play listing metadata and artwork without contacting Google Play"
  lane :listing_package do
    prepare_android_listing_assets
  end

  desc "Validate or upload Google Play listing metadata and artwork only"
  lane :listing do
    package_name = ENV.fetch("ANDROID_PACKAGE_NAME", "com.jjswigut.oopsallprs.android")
    listing_track = ENV.fetch("ANDROID_PLAY_LISTING_TRACK", "internal")
    require_env!("GOOGLE_PLAY_SERVICE_ACCOUNT_JSON")
    json_key_data = ENV.fetch("GOOGLE_PLAY_SERVICE_ACCOUNT_JSON")
    version_code = GooglePlayListing.latest_version_code(
      google_play_track_version_codes(
        package_name: package_name,
        json_key_data: json_key_data,
        track: listing_track
      ),
      track: listing_track
    )

    UI.message("Using existing version code #{version_code} from '#{listing_track}' for listing metadata")

    upload_to_play_store(
      package_name: package_name,
      json_key_data: json_key_data,
      metadata_path: prepare_android_listing_assets,
      track: listing_track,
      version_code: version_code,
      skip_upload_apk: true,
      skip_upload_aab: true,
      skip_upload_metadata: false,
      skip_upload_changelogs: true,
      skip_upload_images: false,
      skip_upload_screenshots: false,
      sync_image_upload: true,
      validate_only: ENV.fetch("ANDROID_PLAY_VALIDATE_ONLY", "true") == "true",
      changes_not_sent_for_review: true,
      rescue_changes_not_sent_for_review: true
    )
  end
end

platform :ios do
  desc "Build the iOS app and upload it to TestFlight"
  lane :beta do
    app_identifier = ENV.fetch("IOS_BUNDLE_ID", "com.jjswigut.oopsallprs.ios")
    live_activity_identifier = ENV.fetch("IOS_LIVE_ACTIVITY_BUNDLE_ID", "#{app_identifier}.RestTimerLiveActivity")
    build_number = ENV.fetch("IOS_BUILD_NUMBER")
    marketing_version = ENV.fetch("IOS_MARKETING_VERSION", "1.0")
    provisioning_profile_name = ENV.fetch("IOS_PROVISIONING_PROFILE_NAME")
    live_activity_provisioning_profile_name = ENV.fetch("IOS_LIVE_ACTIVITY_PROVISIONING_PROFILE_NAME")

    api_key = app_store_connect_key

    sh("cd #{Shellwords.escape(repo_root)} && ./gradlew :shared:linkReleaseFrameworkIosArm64")

    build_app(
      project: File.join(repo_root, "iosApp", "OopsAllPRs.xcodeproj"),
      scheme: "OopsAllPRs",
      configuration: "Release",
      export_method: "app-store",
      output_directory: File.join(repo_root, "iosApp", "build", "fastlane"),
      xcargs: [
        "DEVELOPMENT_TEAM=#{ENV.fetch('APPLE_TEAM_ID')}",
        "CODE_SIGN_STYLE=Manual",
        "CODE_SIGN_IDENTITY=\"Apple Distribution\"",
        "IOS_APP_PROVISIONING_PROFILE_NAME=\"#{provisioning_profile_name}\"",
        "IOS_LIVE_ACTIVITY_PROVISIONING_PROFILE_NAME=\"#{live_activity_provisioning_profile_name}\"",
        "CURRENT_PROJECT_VERSION=#{build_number}",
        "MARKETING_VERSION=#{marketing_version}",
      ].join(" "),
      export_options: {
        method: "app-store",
        signingStyle: "manual",
        teamID: ENV.fetch("APPLE_TEAM_ID"),
        provisioningProfiles: {
          app_identifier => provisioning_profile_name,
          live_activity_identifier => live_activity_provisioning_profile_name,
        },
      }
    )

    ipa_path = lane_context[SharedValues::IPA_OUTPUT_PATH]
    sh(
      "#{Shellwords.escape(File.join(repo_root, 'tools', 'verify_ios_app_bundle.sh'))} " \
      "#{Shellwords.escape(ipa_path)}"
    )

    upload_to_testflight(
      api_key: api_key,
      ipa: ipa_path,
      skip_waiting_for_build_processing: true
    )
  end

  desc "Upload App Store screenshots only"
  lane :listing do
    require_env!("APP_STORE_CONNECT_API_KEY_ID")
    require_env!("APP_STORE_CONNECT_ISSUER_ID")
    require_env!("APP_STORE_CONNECT_API_KEY_BASE64")

    options = {
      api_key: app_store_connect_key,
      app_identifier: ENV.fetch("IOS_BUNDLE_ID", "com.jjswigut.oopsallprs.ios"),
      screenshots_path: prepare_ios_listing_screenshots,
      skip_binary_upload: true,
      skip_metadata: true,
      overwrite_screenshots: true,
      submit_for_review: false,
      force: true,
      run_precheck_before_submit: false
    }
    options[:app_version] = ENV["IOS_APP_VERSION"] unless ENV["IOS_APP_VERSION"].to_s.strip.empty?

    upload_to_app_store(**options)
  end
end
