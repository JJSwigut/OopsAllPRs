CREATE TABLE logging_configurations (
    id TEXT NOT NULL PRIMARY KEY,
    schema_version INTEGER NOT NULL CHECK (schema_version > 0),
    content_hash TEXT NOT NULL UNIQUE,
    source_code TEXT NOT NULL,
    legacy_logging_mode TEXT,
    legacy_set_kind TEXT,
    legacy_had_unexplained_load INTEGER NOT NULL DEFAULT 0 CHECK (legacy_had_unexplained_load IN (0, 1)),
    created_at INTEGER NOT NULL
);

CREATE TABLE logging_configuration_measures (
    logging_configuration_id TEXT NOT NULL,
    position INTEGER NOT NULL CHECK (position >= 0),
    measure_code TEXT NOT NULL,
    requirement_code TEXT NOT NULL,
    canonical_unit_code TEXT NOT NULL,
    load_role_code TEXT,
    PRIMARY KEY(logging_configuration_id, position),
    UNIQUE(logging_configuration_id, measure_code),
    CHECK (
        (measure_code = 'load' AND load_role_code IS NOT NULL) OR
        (measure_code != 'load' AND load_role_code IS NULL)
    ),
    FOREIGN KEY(logging_configuration_id) REFERENCES logging_configurations(id) ON DELETE CASCADE
);

CREATE TABLE logging_configuration_effort_kinds (
    logging_configuration_id TEXT NOT NULL,
    position INTEGER NOT NULL CHECK (position >= 0),
    effort_kind_code TEXT NOT NULL,
    PRIMARY KEY(logging_configuration_id, position),
    UNIQUE(logging_configuration_id, effort_kind_code),
    FOREIGN KEY(logging_configuration_id) REFERENCES logging_configurations(id) ON DELETE CASCADE
);

CREATE TABLE active_workouts (
    id TEXT NOT NULL PRIMARY KEY,
    started_at INTEGER NOT NULL,
    routine_id TEXT,
    routine_snapshot_name TEXT,
    status TEXT NOT NULL,
    created_at INTEGER NOT NULL,
    updated_at INTEGER NOT NULL
);

CREATE TABLE active_exercises (
    id TEXT NOT NULL PRIMARY KEY,
    active_workout_id TEXT NOT NULL,
    exercise_catalog_id TEXT NOT NULL,
    display_name_snapshot TEXT NOT NULL,
    equipment_snapshot TEXT,
    is_bodyweight INTEGER NOT NULL,
    position INTEGER NOT NULL,
    logging_mode TEXT NOT NULL DEFAULT 'WEIGHTED',
    group_id TEXT,
    group_position INTEGER,
    group_label TEXT,
    group_rounds INTEGER,
    rest_seconds INTEGER NOT NULL DEFAULT 120,
    rest_auto_start INTEGER NOT NULL DEFAULT 1,
    logging_configuration_id TEXT,
    FOREIGN KEY(active_workout_id) REFERENCES active_workouts(id) ON DELETE CASCADE,
    FOREIGN KEY(logging_configuration_id) REFERENCES logging_configurations(id)
);

CREATE TABLE exercise_sets (
    id TEXT NOT NULL PRIMARY KEY,
    workout_id TEXT NOT NULL,
    exercise_instance_id TEXT NOT NULL,
    position INTEGER NOT NULL,
    set_kind TEXT NOT NULL,
    weight_kg REAL,
    reps INTEGER,
    duration_ms INTEGER,
    logged_at INTEGER,
    created_at INTEGER NOT NULL,
    updated_at INTEGER NOT NULL,
    edited_at INTEGER,
    capture_configuration_id TEXT,
    distance_m REAL CHECK (distance_m IS NULL OR distance_m >= 0),
    rpe_tenths INTEGER CHECK (rpe_tenths IS NULL OR rpe_tenths BETWEEN 10 AND 100),
    rir INTEGER CHECK (rir IS NULL OR rir BETWEEN 0 AND 10),
    failure_outcome TEXT,
    FOREIGN KEY(capture_configuration_id) REFERENCES logging_configurations(id)
);

CREATE TABLE active_session_state (
    singleton_id INTEGER NOT NULL PRIMARY KEY CHECK (singleton_id = 1),
    active_workout_id TEXT,
    started_at INTEGER,
    rest_ends_at INTEGER,
    rest_started_at INTEGER,
    rest_origin_set_id TEXT,
    last_opened_route TEXT,
    updated_at INTEGER NOT NULL
);

CREATE TABLE routines (
    id TEXT NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    source_completed_workout_id TEXT,
    created_at INTEGER NOT NULL,
    updated_at INTEGER NOT NULL,
    archived_at INTEGER
);

CREATE TABLE routine_exercises (
    id TEXT NOT NULL PRIMARY KEY,
    routine_id TEXT NOT NULL,
    exercise_catalog_id TEXT NOT NULL,
    display_name_snapshot TEXT NOT NULL,
    position INTEGER NOT NULL,
    group_id TEXT,
    group_position INTEGER,
    group_rounds INTEGER,
    rest_seconds INTEGER NOT NULL DEFAULT 120,
    rest_auto_start INTEGER NOT NULL DEFAULT 1,
    logging_configuration_id TEXT,
    FOREIGN KEY(routine_id) REFERENCES routines(id) ON DELETE CASCADE,
    FOREIGN KEY(logging_configuration_id) REFERENCES logging_configurations(id)
);

CREATE TABLE routine_set_templates (
    id TEXT NOT NULL PRIMARY KEY,
    routine_exercise_id TEXT NOT NULL,
    position INTEGER NOT NULL,
    target_weight_kg REAL,
    target_reps INTEGER,
    target_duration_ms INTEGER,
    set_kind TEXT NOT NULL,
    logging_configuration_id TEXT,
    target_distance_m REAL CHECK (target_distance_m IS NULL OR target_distance_m >= 0),
    target_effort_kind TEXT,
    target_rpe_tenths INTEGER CHECK (target_rpe_tenths IS NULL OR target_rpe_tenths BETWEEN 10 AND 100),
    target_rir INTEGER
        CHECK (target_rir IS NULL OR target_rir BETWEEN 0 AND 10)
        CHECK (
            (target_effort_kind IS NULL AND target_rpe_tenths IS NULL AND target_rir IS NULL) OR
            (target_effort_kind = 'rpe' AND target_rpe_tenths IS NOT NULL AND target_rir IS NULL) OR
            (target_effort_kind = 'rir' AND target_rpe_tenths IS NULL AND target_rir IS NOT NULL) OR
            (target_effort_kind = 'to_failure' AND target_rpe_tenths IS NULL AND target_rir IS NULL)
        ),
    FOREIGN KEY(routine_exercise_id) REFERENCES routine_exercises(id) ON DELETE CASCADE,
    FOREIGN KEY(logging_configuration_id) REFERENCES logging_configurations(id)
);

CREATE TABLE completed_workouts (
    id TEXT NOT NULL PRIMARY KEY,
    source_active_workout_id TEXT NOT NULL,
    started_at INTEGER NOT NULL,
    finished_at INTEGER NOT NULL,
    duration_ms INTEGER NOT NULL,
    routine_id TEXT,
    created_at INTEGER NOT NULL
);

CREATE TABLE exercise_catalog (
    id TEXT NOT NULL PRIMARY KEY,
    canonical_name TEXT NOT NULL UNIQUE,
    display_name TEXT NOT NULL,
    muscle_group TEXT NOT NULL,
    equipment TEXT NOT NULL,
    movement_pattern TEXT NOT NULL,
    exercise_type TEXT NOT NULL,
    experience_level TEXT NOT NULL,
    body_region TEXT NOT NULL,
    is_bodyweight INTEGER NOT NULL,
    logging_mode TEXT NOT NULL DEFAULT 'WEIGHTED',
    is_user_created INTEGER NOT NULL,
    created_at INTEGER NOT NULL,
    updated_at INTEGER NOT NULL,
    archived_at INTEGER,
    source_seed_version TEXT,
    user_notes TEXT,
    definition_origin TEXT,
    definition_revision INTEGER CHECK (definition_revision IS NULL OR definition_revision > 0),
    seed_id TEXT,
    seed_manifest_revision TEXT,
    default_logging_configuration_id TEXT,
    FOREIGN KEY(default_logging_configuration_id) REFERENCES logging_configurations(id)
);

CREATE UNIQUE INDEX exercise_catalog_seed_id_unique
ON exercise_catalog(seed_id)
WHERE seed_id IS NOT NULL;

CREATE TABLE user_exercise_configurations (
    exercise_catalog_id TEXT NOT NULL PRIMARY KEY,
    logging_configuration_id TEXT NOT NULL,
    based_on_definition_revision INTEGER NOT NULL CHECK (based_on_definition_revision > 0),
    created_at INTEGER NOT NULL,
    updated_at INTEGER NOT NULL,
    FOREIGN KEY(exercise_catalog_id) REFERENCES exercise_catalog(id) ON DELETE CASCADE,
    FOREIGN KEY(logging_configuration_id) REFERENCES logging_configurations(id)
);

CREATE TABLE exercise_seed_imports (
    id TEXT NOT NULL PRIMARY KEY,
    source_name TEXT NOT NULL,
    source_hash TEXT NOT NULL,
    imported_at INTEGER NOT NULL,
    row_count INTEGER NOT NULL,
    rejected_row_count INTEGER NOT NULL,
    warnings TEXT NOT NULL
);

CREATE TABLE user_preferences (
    singleton_id INTEGER NOT NULL PRIMARY KEY CHECK (singleton_id = 1),
    weight_unit TEXT NOT NULL,
    date_format TEXT,
    default_rest_seconds INTEGER NOT NULL,
    rest_sound_enabled INTEGER NOT NULL DEFAULT 1,
    rest_timer_surface_enabled INTEGER NOT NULL DEFAULT 1,
    weight_step_lb REAL NOT NULL DEFAULT 5.0,
    weight_step_kg REAL NOT NULL DEFAULT 2.5,
    android_auto_backup_allowed INTEGER NOT NULL,
    start_timer_on_first_set INTEGER NOT NULL DEFAULT 1,
    created_at INTEGER NOT NULL,
    updated_at INTEGER NOT NULL
);

CREATE TABLE personal_records (
    id TEXT NOT NULL PRIMARY KEY,
    exercise_catalog_id TEXT NOT NULL,
    record_kind TEXT NOT NULL,
    reps INTEGER,
    weight_kg REAL,
    value REAL NOT NULL,
    source_workout_id TEXT NOT NULL,
    source_set_id TEXT NOT NULL,
    achieved_at INTEGER NOT NULL,
    created_at INTEGER NOT NULL,
    metric_code TEXT,
    derivation_version INTEGER CHECK (derivation_version IS NULL OR derivation_version > 0)
);

CREATE TABLE progress_points (
    id TEXT NOT NULL PRIMARY KEY,
    exercise_catalog_id TEXT NOT NULL,
    source_workout_id TEXT NOT NULL,
    source_set_id TEXT,
    metric TEXT NOT NULL,
    value REAL NOT NULL,
    weight_kg REAL,
    reps INTEGER,
    recorded_at INTEGER NOT NULL,
    metric_code TEXT,
    derivation_version INTEGER CHECK (derivation_version IS NULL OR derivation_version > 0)
);

CREATE TABLE export_snapshots (
    id TEXT NOT NULL PRIMARY KEY,
    export_type TEXT NOT NULL,
    created_at INTEGER NOT NULL,
    weight_unit TEXT NOT NULL,
    row_count INTEGER NOT NULL,
    format_version INTEGER NOT NULL
);

CREATE TABLE active_workout_ux_sessions (
    active_workout_id TEXT NOT NULL PRIMARY KEY,
    focused_exercise_instance_id TEXT,
    focused_draft_id TEXT,
    updated_at INTEGER NOT NULL,
    FOREIGN KEY(active_workout_id) REFERENCES active_workouts(id) ON DELETE CASCADE
);

CREATE TABLE active_set_drafts (
    draft_id TEXT NOT NULL PRIMARY KEY,
    active_workout_id TEXT NOT NULL,
    exercise_instance_id TEXT NOT NULL,
    position INTEGER NOT NULL,
    set_kind TEXT NOT NULL,
    reps INTEGER,
    weight_kg REAL,
    duration_ms INTEGER,
    timer_started_at INTEGER,
    updated_at INTEGER NOT NULL,
    logging_configuration_id TEXT,
    distance_m REAL CHECK (distance_m IS NULL OR distance_m >= 0),
    rpe_tenths INTEGER CHECK (rpe_tenths IS NULL OR rpe_tenths BETWEEN 10 AND 100),
    rir INTEGER CHECK (rir IS NULL OR rir BETWEEN 0 AND 10),
    failure_outcome TEXT,
    FOREIGN KEY(active_workout_id) REFERENCES active_workouts(id) ON DELETE CASCADE,
    FOREIGN KEY(exercise_instance_id) REFERENCES active_exercises(id) ON DELETE CASCADE,
    FOREIGN KEY(logging_configuration_id) REFERENCES logging_configurations(id)
);

CREATE TABLE sync_state (
    singleton_id INTEGER NOT NULL PRIMARY KEY CHECK (singleton_id = 1),
    linked_backup_display_name TEXT,
    provider_reference TEXT,
    provider_reference_kind TEXT,
    last_backup_revision TEXT,
    last_backup_timestamp INTEGER,
    last_local_revision TEXT,
    last_local_timestamp INTEGER,
    last_outcome TEXT NOT NULL,
    last_error TEXT,
    last_conflict_summary TEXT,
    updated_at INTEGER NOT NULL
);

CREATE TABLE full_access_state (
    singleton_id INTEGER NOT NULL PRIMARY KEY CHECK (singleton_id = 1),
    completed_free_workouts INTEGER NOT NULL,
    lifetime_active INTEGER NOT NULL,
    store_status TEXT NOT NULL,
    last_error TEXT,
    updated_at INTEGER NOT NULL
);

CREATE TRIGGER logging_configurations_no_update
BEFORE UPDATE ON logging_configurations
BEGIN
    SELECT RAISE(ABORT, 'logging configurations are immutable');
END;

CREATE TRIGGER logging_configurations_no_delete
BEFORE DELETE ON logging_configurations
BEGIN
    SELECT RAISE(ABORT, 'logging configurations are immutable');
END;

CREATE TRIGGER logging_configuration_measures_no_update
BEFORE UPDATE ON logging_configuration_measures
BEGIN
    SELECT RAISE(ABORT, 'logging configuration measures are immutable');
END;

CREATE TRIGGER logging_configuration_measures_no_delete
BEFORE DELETE ON logging_configuration_measures
BEGIN
    SELECT RAISE(ABORT, 'logging configuration measures are immutable');
END;

CREATE TRIGGER logging_configuration_effort_kinds_no_update
BEFORE UPDATE ON logging_configuration_effort_kinds
BEGIN
    SELECT RAISE(ABORT, 'logging configuration effort kinds are immutable');
END;

CREATE TRIGGER logging_configuration_effort_kinds_no_delete
BEFORE DELETE ON logging_configuration_effort_kinds
BEGIN
    SELECT RAISE(ABORT, 'logging configuration effort kinds are immutable');
END;
