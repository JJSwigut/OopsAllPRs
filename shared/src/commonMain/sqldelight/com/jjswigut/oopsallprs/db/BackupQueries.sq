upsertSyncState:
INSERT OR REPLACE INTO sync_state(
    singleton_id,
    linked_backup_display_name,
    provider_reference,
    provider_reference_kind,
    last_backup_revision,
    last_backup_timestamp,
    last_local_revision,
    last_local_timestamp,
    last_outcome,
    last_error,
    last_conflict_summary,
    updated_at
)
VALUES (1, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

selectSyncState:
SELECT * FROM sync_state
WHERE singleton_id = 1;

clearSyncState:
DELETE FROM sync_state
WHERE singleton_id = 1;

